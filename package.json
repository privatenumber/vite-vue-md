{
	"name": "vite-vue-md",
	"version": "0.0.0",
	"description": "Vite plugin to import Markdown files as Vue components",
	"keywords": [
		"vue",
		"vue 2",
		"vue 3",
		"vite",
		"plugin",
		"markdown",
		"md"
	],
	"license": "MIT",
	"repository": "github:privatenumber/vite-vue-md",
	"funding": "https://github.com/privatenumber/vite-vue-md?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#vite-vue-md": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
	"scripts": {
		"build": "pkgroll",
		"test": "pnpm --use-node-version=20.11.0 tsx tests",
		"dev": "tsx watch --conditions=development tests",
		"playground": "vite ./playground --open",
		"type-check": "tsc",
		"lint": "lintroll --git",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=20.11.0"
	},
	"dependencies": {
		"markdown-it": "^14.0.0"
	},
	"peerDependencies": {
		"vite": "^5.0.0"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/markdown-it": "^14.1.2",
		"@vitejs/plugin-vue": "^5.0.3",
		"@vue/test-utils": "^2.4.4",
		"clean-pkg-json": "^1.2.0",
		"fs-fixture": "^2.11.0",
		"happy-dom": "^20.8.8",
		"lintroll": "^1.26.0",
		"manten": "^1.2.0",
		"markdown-it-anchor": "^9.2.0",
		"outdent": "^0.8.0",
		"pkgroll": "^2.0.1",
		"rollup": "^4.9.6",
		"tsx": "^4.7.0",
		"typescript": "5.9.3",
		"vite": "^5.0.12",
		"vue": "^3.4.15"
	}
}
